# Demo orchestrator environment config
# Copy this to .env and fill in your values
# Load with: export $(cat .env | xargs)

# ── Stack endpoints ─────────────────────────────────────────────
GATEWAY_URL=http://localhost:8082
LANGFUSE_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090
TEMPO_URL=http://localhost:3200
FEATURE_FLAG_URL=http://localhost:8080

# ── Langfuse credentials ────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# ── Tenant API keys (issued by Gravitee) ────────────────────────
TENANT_A_API_KEY=gw-tenant-a-...
TENANT_B_API_KEY=gw-tenant-b-...
TENANT_C_API_KEY=gw-tenant-c-...
TENANT_D_API_KEY=gw-tenant-d-...

# ── Load parameters ─────────────────────────────────────────────
# BURST_RPS must sit just above sustainable throughput
# (≈ natsWorker.concurrency / per-request latency, ~8 req/s on the demo GPUs).
# The 90 s burst backlog grows by (BURST_RPS − throughput) per second — aim for a
# NATS queue of 20-40 and p99 of 5-9 s. See "Tuning BURST_RPS" in README.md.
BURST_RPS=8
